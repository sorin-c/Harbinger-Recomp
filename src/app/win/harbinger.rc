// Windows version information and manifest for harbinger.exe.
#include <winver.h>

1 24 "harbinger.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,2,0,0
PRODUCTVERSION 0,2,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Harbinger Recomp project"
            VALUE "FileDescription", "Harbinger Recomp (open-source engine rebuild)"
            VALUE "FileVersion", "0.2.0"
            VALUE "InternalName", "harbinger"
            VALUE "OriginalFilename", "harbinger.exe"
            VALUE "ProductName", "Harbinger Recomp"
            VALUE "ProductVersion", "0.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
